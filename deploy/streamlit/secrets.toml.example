# Paste the contents into: share.streamlit.io -> your app -> Settings -> Secrets   (NEVER commit a real secrets file)

# --- Real LLM (recommended). Use a free-tier key with a quota cap: every visitor spends it. ---
SENTINEL_LLM_PROVIDER = "gemini"
SENTINEL_LLM_MODEL = "gemini-2.5-flash"
GOOGLE_API_KEY = "paste-your-key-here"

# --- Optional ---
# SENTINEL_MAX_RUNS_PER_HOUR = "30"     # demo-wide cap on research runs per hour (0 = unlimited)
# SENTINEL_SEARCH = "none"              # disable web search if DuckDuckGo rate-limits the shared IP
# SENTINEL_MAX_LOOPS = "2"              # fewer critic retries = fewer LLM calls per run

# Leave GOOGLE_API_KEY out entirely for the keyless demo (stand-in LLM, extractive answers).
