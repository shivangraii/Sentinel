# ---------- LLM ----------
# provider: gemini | groq | ollama | anthropic | fake   ("fake" = offline demo mode, no API key)
SENTINEL_LLM_PROVIDER=gemini
SENTINEL_LLM_MODEL=gemini-2.5-flash
# Model names change over time; check your provider's docs if a name stops working.
#   groq:      llama-3.3-70b-versatile
#   ollama:    llama3.1:8b
#   anthropic: claude-haiku-4-5-20251001
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings / reranker ----------
# embeddings: sentence-transformers | hash   ("hash" = offline, lower quality, no downloads)
SENTINEL_EMBEDDINGS=sentence-transformers
SENTINEL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# reranker: cross-encoder | lexical
SENTINEL_RERANKER=cross-encoder
SENTINEL_RERANKER_MODEL=BAAI/bge-reranker-base

# ---------- Web search ----------
# search: duckduckgo | tavily | none
SENTINEL_SEARCH=duckduckgo
TAVILY_API_KEY=

# ---------- Observability (optional) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Behaviour ----------
SENTINEL_REQUIRE_APPROVAL=false
SENTINEL_MAX_LOOPS=3
